# Generate a private real file with scripts/verda_prepare_secrets.py.
# Never place the real file inside the release or static tree.
AI_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_SERVER_SIDE_ONLY
GEMINI_MODEL=REPLACE_WITH_CURRENT_CONFIGURED_MODEL
GEMINI_RECONSTRUCTION_MODEL=REPLACE_WITH_CURRENT_CONFIGURED_RECONSTRUCTION_MODEL
BLUEPRINT_STORAGE_ROOT=/srv/blueprint-data/runtime
BLUEPRINT_PUBLIC_DEMO=1
BLUEPRINT_PUBLIC_EXAMPLES_FILE=/srv/blueprint-data/public-examples.json
BLUEPRINT_DEMO_ACCESS_CODE_HASH=REPLACE_WITH_SALTED_VERIFIER
BLUEPRINT_DEMO_SESSION_SECRET=REPLACE_WITH_RANDOM_SERVER_SECRET
