GEMINI_API_KEY=
# Model availability depends on your account; check before a live demo.
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_INTERPRETATION_MODEL=gemini-4-hydrogen
GEMINI_CLARIFICATION_MODEL=gemini-3.8-flash
# Agentic chat capabilities. Decisions is used only for factual support review.
GEMINI_BASIC_MODEL=gemini-3.8-flash
GEMINI_ADVANCED_MODEL=gemini-4-hydrogen
GEMINI_ROUTER_MODEL=gemini-3.8-flash
GEMINI_UI_MODEL=gemini-3.8-flash
GEMINI_RENDER_MODEL=gemini-4-hydrogen
# Agent answers default to 65536 output tokens for advanced and 8192 for basic.
# Optional override for the selected worker, also used for its corrective answer:
# GEMINI_AGENT_ANSWER_TOKENS=65536
# Reconstruction uses the separately selected Gemini model; never automatic fallback.
GEMINI_RECONSTRUCTION_MODEL=gemini-3.1-pro-preview
GEMINI_DECISION_MODEL=gemini-decision-1

# Local durable bundles; one application process per storage root.
BLUEPRINT_STORAGE_ROOT=.runtime
# Hackathon execution budgets: design choices, not source-completeness guarantees.
RECONSTRUCTION_CALL_SECONDS=300
RECONSTRUCTION_MAX_TOKENS=65536
RECONSTRUCTION_REVIEW_SECONDS=120
RECONSTRUCTION_REVIEW_TOKENS=16384
# Legacy reconstruction only; the agentic render tool has no total/round limit.
RECONSTRUCTION_JOB_SECONDS=900
RECONSTRUCTION_PATCH_ATTEMPTS=2
QA_TOTAL_SECONDS=180
GEMINI_DRAFT_SECONDS=90

# Optional voice input: Gemini Live transcription.
# Uses GEMINI_API_KEY above. Empty language codes enable automatic detection.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-live
VOICE_LANGUAGE_CODES=
VOICE_CONNECT_TIMEOUT_SECONDS=20
VOICE_FINALIZATION_TIMEOUT_SECONDS=15
VOICE_SPEECH_TIMEOUT_SECONDS=60

# Optional voice output: use a voice available to your ElevenLabs account.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Public-demo code requirement; public mode itself is configured on the server.
BLUEPRINT_DEMO_REQUIRE_ACCESS_CODE=1
# Optional operator-owned policy file (code/open or an aware one-time window).
# A configured missing/invalid file requires the code; it overrides the flag above.
# BLUEPRINT_DEMO_ACCESS_MODE_FILE=/etc/blueprint-agentic/access-mode
